DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Enable server-side DeepSeek calls after configuring the key and usage bounds.
DEEPSEEK_ENABLED=false
# Default request timeout in milliseconds.
DEEPSEEK_TIMEOUT_MS=12000

# Set true in Vercel Preview and Production, including when system variables are disabled.
# Both environments use the same Upstash database and seeded counter.
DEEPSEEK_REQUIRE_ATTEMPT_BUDGET=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
